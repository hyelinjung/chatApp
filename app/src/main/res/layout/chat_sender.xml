<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:padding="8dp">
    <LinearLayout
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/edittext_background"
        android:padding="7dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/sender_dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024년 8월 23일 금요일"
            android:textSize="12sp"
            android:textColor="@color/black"
            />
    </LinearLayout>
    <TextView
        android:id="@+id/senderView"
        android:layout_below="@id/time"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sent message text"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:background="@drawable/edittext_background"
        android:backgroundTint="#ECEBEB"
        android:padding="10dp"
        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/sent_message_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안 읽음"
            android:textColor="@color/red"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10sp"
            android:textSize="10sp"/>


        <TextView
            android:id="@+id/sent_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:00PM"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>


</LinearLayout>
